{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forme-store",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/oauth", "/oauth/*", "/.well-known/*", "/mcp", "/mcp/*", "/health", "/health/*"]
  },
  "vars": {
    // Set the public HTTPS origin with --var BASE_URL:https://… when deploying.
    "BASE_URL": "https://forme-store.adeyemigabriel429.workers.dev",
    "MCP_ALLOWED_ORIGINS": ""
  },
  "durable_objects": {
    "bindings": [{
      "name": "STORE",
      "class_name": "FormeStore"
    }]
  },
  "migrations": [{
    "tag": "v1",
    "new_sqlite_classes": ["FormeStore"]
  }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
